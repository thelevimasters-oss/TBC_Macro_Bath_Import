<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hydro: EchoSounding -&gt; GNSS Vertical Offset"
        Height="560" Width="820"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Input -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Input JXL:" VerticalAlignment="Center" Margin="0,0,8,6" />
        <TextBox x:Name="txtInputPath" Grid.Row="0" Grid.Column="1" Margin="0,0,8,6" MinHeight="24" />
        <Button x:Name="btnBrowseInput" Grid.Row="0" Grid.Column="2" Content="Browse..." Margin="0,0,0,6" MinHeight="24" MinWidth="90" />

        <!-- Output -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Output JXL:" VerticalAlignment="Center" Margin="0,0,8,6" />
        <TextBox x:Name="txtOutputPath" Grid.Row="1" Grid.Column="1" Margin="0,0,8,6" MinHeight="24" />
        <Button x:Name="btnBrowseOutput" Grid.Row="1" Grid.Column="2" Content="Browse..." Margin="0,0,0,6" MinHeight="24" MinWidth="90" />

        <!-- Options -->
        <GroupBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Header="Options" Margin="0,0,0,10">
            <StackPanel Margin="10">
                <CheckBox x:Name="chkRemoveEchoSounding" Content="Remove &lt;EchoSounding&gt; blocks (recommended / required for import compatibility)" IsChecked="True" Margin="0,0,0,4" />
                <CheckBox x:Name="chkRemoveEchoConfig" Content="Remove &lt;EchoSounderConfigurationRecord&gt; blocks (recommended for older TBC)" IsChecked="True" Margin="0,0,0,4" />
                <CheckBox x:Name="chkUseSecondaryDepth" Content="If &lt;Depth&gt; is blank, use &lt;SecondaryDepth&gt;" IsChecked="True" Margin="0,0,0,4" />
                <CheckBox x:Name="chkKeepExtraAsNotes" Content="Store removed EchoSounding values (Depth + ExtraData) as point Notes" IsChecked="True" Margin="0,0,0,4" />
                <CheckBox x:Name="chkConvertDepthFromFeet" Content="Convert depth from US survey feet to meters before creating VerticalOffset" IsChecked="False" Margin="0,0,0,4" />
                <CheckBox x:Name="chkOverwriteExisting" Content="Overwrite existing &lt;GNSSVerticalOffset&gt; if present" IsChecked="False" Margin="0,0,0,4" />
                <CheckBox x:Name="chkImportIntoTbc" Content="Import converted JXL into the current TBC project after saving" IsChecked="True" Margin="0,6,0,0" />
            </StackPanel>
        </GroupBox>

        <!-- Log -->
        <GroupBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Header="Report / Log">
            <Grid Margin="10">
                <TextBox x:Name="txtLog"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" />
            </Grid>
        </GroupBox>

        <!-- Footer and Buttons -->
        <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Bottom">
                <TextBlock Text="V: 1.0" />
                <TextBlock Text="Created By: Levi Masters" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnRun" Content="Convert &amp; Import" MinWidth="140" MinHeight="30" Margin="0,0,8,0" />
                <Button x:Name="btnClose" Content="Close" MinWidth="90" MinHeight="30" />
            </StackPanel>
        </Grid>

    </Grid>
</Window>
